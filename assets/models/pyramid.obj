# Original teaching mesh: a square pyramid with outward-facing triangles.
# Five vertices, six triangles. Y is up; all coordinates are model-space positions.
o Pyramid

v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5 -0.5 -0.5
v -0.5 -0.5 -0.5
v  0.0  0.5  0.0

# Four sides
f 1 2 5
f 2 3 5
f 3 4 5
f 4 1 5

# Square base split into two triangles
f 1 4 3
f 1 3 2
